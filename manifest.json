{
  "manifest_version": 3,
  "name": "Web Page Summarizer - Local AI",
  "version": "1.6.3",
  "description": "表示中のWebページの本文を、Chrome内蔵AI(Gemini Nano)で要約して右サイドパネルに表示します。",
  "minimum_chrome_version": "138",
  "permissions": ["sidePanel", "scripting", "activeTab", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Web Page Summarizer - Local AI を開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
